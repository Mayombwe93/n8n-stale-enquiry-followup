    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst lines = items.map((r, i) => `${i + 1}. ID ${r.ID} | ${r.Name || '-'} | ${r.Email || '-'} | Status: ${r.Status || '-'} | Last updated: ${r.LastUpdated} | Age: ${r._ageHours}h`);\nlet text = `Stale Enquiry Alert: ${items.length} enquir${items.length === 1 ? 'y' : 'ies'} with no update for 48+ hours\\n\\n${lines.join('\\n')}\\n\\nPlease follow up.`;\nif (text.length > 3900) text = text.slice(0, 3900) + '\\n...(truncated)';\nconst rows = items.map(r => ({ ID: r.ID, ReminderCount: r.ReminderCount }));\nreturn [{ json: { text, count: items.length, rows } }];"
      },
