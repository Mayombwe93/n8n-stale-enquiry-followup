      "parameters": {
        "jsCode": "const nowIso = new Date().toISOString();\nconst rows = $('Build Alert Summary').first().json.rows;\n\nreturn rows.map(r => ({\n  json: {\n    ID: r.ID,\n    LastReminderAt: nowIso,\n    ReminderSent: true,\n    ReminderCount: Number(r.ReminderCount || 0) + 1\n  }\n}));"
      },
