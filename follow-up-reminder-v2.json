      "id": "b2c3d4e5-0001-4000-8000-000000000001",
      "name": "Daily Schedule Trigger 9AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 360]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "YOUR_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Enquiries",
          "mode": "name"
        },
        "filtersUI": {
          "values": []
        },
        "returnAll": true,
        "options": {}
      },
      "id": "b2c3d4e5-0002-4000-8000-000000000002",
      "name": "Get All Enquiries",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.6,
      "position": [440, 360],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const results = [];\n\nconst toDate = (value) => {\n  if (typeof value === 'number') {\n    return new Date(Date.UTC(1899, 11, 30) + value * 86400000);\n  }\n  return new Date(value);\n};\n\nconst toBool = (value) => value === true || String(value).trim().toUpperCase() === 'TRUE';\n\nfor (const item of $input.all()) {\n  const row = item.json;\n  const output = { ...row };\n\n  if (!row.ID || !row.LastUpdated) {\n    output._eligible = false;\n    output._needsFlagReset = false;\n    output._reason = 'Missing ID or LastUpdated';\n    results.push({ json: output });\n    continue;\n  }\n\n  const lastUpdated = toDate(row.LastUpdated);\n  if (isNaN(lastUpdated.getTime())) {\n    output._eligible = false;\n    output._needsFlagReset = false;\n    output._reason = 'Invalid LastUpdated date';\n    results.push({ json: output });\n    continue;\n  }\n\n  const ageHours = (Date.now() - lastUpdated.getTime()) / 3600000;\n  output._ageHours = Math.round(ageHours * 100) / 100;\n\n  let lastReminderAt = null;\n  if (row.LastReminderAt) {\n    const parsed = toDate(row.LastReminderAt);\n    if (!isNaN(parsed.getTime())) lastReminderAt = parsed;\n  }\n\n  // A reminder was already sent for this stale cycle if the last update is not newer than the last reminder.\n  const alreadyRemindedThisCycle = lastReminderAt !== null && lastUpdated.getTime() <= lastReminderAt.getTime();\n  const isStale = ageHours >= 48;\n  const isClosed = String(row.Status || '').trim().toLowerCase() === 'closed';\n\n  output._eligible = isStale && !isClosed && !alreadyRemindedThisCycle;\n\n  // Derived flag: true only when a reminder has been sent in the current cycle.\n  output._derivedReminderSent = alreadyRemindedThisCycle;\n\n  // Reset the sheet flag when it says true but no reminder exists for the current cycle.\n  // Eligible rows are excluded because the reminder branch sets their flag to true.\n  output._needsFlagReset = !alreadyRemindedThisCycle && !output._eligible && toBool(row.ReminderSent);\n\n  output._reason = output._eligible\n    ? 'Eligible'\n    : `Not eligible (stale=${isStale}, closed=${isClosed}, alreadyReminded=${alreadyRemindedThisCycle})`;\n\n  results.push({ json: output });\n}\n\nreturn results;"
      },
